# ==============================================================================
# CareerConnect Platform — Root Environment Configuration
# ==============================================================================

# Backend Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Required when SPRING_PROFILES_ACTIVE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careerconnect
DB_USERNAME=root
DB_PASSWORD=rootpassword

# JWT Security
JWT_SECRET=careerconnect_super_secret_jwt_key_that_is_at_least_256_bits_long_for_security_compliance_2026!
JWT_EXPIRATION_MS=86400000

# File Upload Storage
FILE_UPLOAD_DIR=./uploads

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
